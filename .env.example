# Supabase project "James Reports"
# Copy to .env.local and fill in. Vite only exposes variables prefixed with VITE_
# to the browser, and only the publishable key may ever be one of them.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-side only (admin scripts). Never prefix it with VITE_ and never ship it to the page.
SUPABASE_SECRET_KEY=
