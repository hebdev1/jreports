{
  "name": "james-reports",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "James Reports with James Pierre — website (Vite + React + TypeScript, Supabase backend).",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
