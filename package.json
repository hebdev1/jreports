    "test:watch": "vitest",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@supabase/postgrest-js": "^2.118.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
